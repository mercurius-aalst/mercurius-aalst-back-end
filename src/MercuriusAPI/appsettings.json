{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "Location": "C:\\Development\\Personal\\images",
    "MaxFileSizeInMB": 5
  },
